<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HongGuoEnhance">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.HongGuoEnhance"
            android:windowSoftInputMode="adjustResize">
            <!-- 模块设置页标准入口（Xposed/LSPosed 规范类别）：桌面图标被隐藏
                 (.LauncherAlias 被禁用) 后，LSPosed 管理器通过该类别仍能解析到
                 启动 Intent（AppHelper.getSettingsIntent 优先查此类别），
                 "启动"按钮因此不会消失。INFO 类别是 getLaunchIntentForPackage
                 的第一优先回退，一并声明。exported 保持 false：LSPosed 守护进程
                 以 root 身份启动，无需导出。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- LAUNCHER intent-filter 挂在别名上：隐藏桌面图标 = 禁用本别名,
             MainActivity 本体保持可用, 隐藏后在 LSPosed 管理器中打开 -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:label="评论词条日志"
            android:theme="@style/Theme.HongGuoEnhance" />

        <!-- 过滤规则二级设置页：管理评论采集的排除型正则（独立保存） -->
        <activity
            android:name=".FilterRulesActivity"
            android:exported="false"
            android:label="过滤规则"
            android:theme="@style/Theme.HongGuoEnhance"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI 进程桥：宿主(红果)进程经 ContentResolver.call 把 AI 请求交给
             模块进程执行，代理白名单只需放行模块应用。exported 但 Provider
             内部校验调用方 UID 必须为 com.phoenix.read。 -->
        <provider
            android:name=".hook.AiBridgeProvider"
            android:authorities="io.github.imroxy2222.lsp_hongguoenhance.aibridge"
            android:exported="true" />

        <!-- AI 进程桥保活锚点：空服务，供宿主进程（hook 内 BridgeKeepAlive）
             bindService(BIND_AUTO_CREATE) 自动拉起并锚定模块进程——宿主存活
             期间模块进程不进 cached/冻结态，"AI 走模块进程"始终可用。
             必须 exported（跨应用绑定要求）；服务无接口无数据，绑定无副作用。 -->
        <service
            android:name=".hook.AiKeepAliveService"
            android:exported="true" />
    </application>

</manifest>
