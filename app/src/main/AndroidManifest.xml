<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HongGuoEnhance">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.HongGuoEnhance"
            android:windowSoftInputMode="adjustResize" />

        <!-- LAUNCHER intent-filter 挂在别名上：隐藏桌面图标 = 禁用本别名,
             MainActivity 本体保持可用, 隐藏后在 LSPosed 管理器中打开 -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:label="评论词条日志"
            android:theme="@style/Theme.HongGuoEnhance" />

        <!-- 过滤规则二级设置页：管理评论采集的排除型正则（独立保存） -->
        <activity
            android:name=".FilterRulesActivity"
            android:exported="false"
            android:label="过滤规则"
            android:theme="@style/Theme.HongGuoEnhance"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI 进程桥：宿主(红果)进程经 ContentResolver.call 把 AI 请求交给
             模块进程执行，代理白名单只需放行模块应用。exported 但 Provider
             内部校验调用方 UID 必须为 com.phoenix.read。 -->
        <provider
            android:name=".hook.AiBridgeProvider"
            android:authorities="io.github.imroxy2222.lsp_hongguoenhance.aibridge"
            android:exported="true" />
    </application>

</manifest>
